#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
agenic_root="$(cd "$script_dir/../.." && pwd)"
source "$agenic_root/pony/scripts/launch-debug.sh"
source "$agenic_root/pony/scripts/pony-paths.sh"
source "$agenic_root/pony/bin/codex-prompt-style.sh"
current_script="$script_dir/$(basename "${BASH_SOURCE[0]}")"
pony_launch_debug_init

project_root="$(detect_project_root "${PWD}")"
load_project_paths "$project_root"
pony_launch_debug "codex-pony entry: pwd=$PWD project_root=$project_root current_script=$current_script arg_count=$#"

if [[ ! -f "$AGENIC_PROJECT_PONY_CONFIG_PATH" ]]; then
  "$agenic_root/scripts/install-project.sh" "$project_root" >/dev/null
  load_project_paths "$project_root"
fi

project_codex_pony="$project_root/pony/bin/codex-pony"
if [[ "$project_root" != "$agenic_root" ]] && [[ "${AGENIC_PONY_REFRESH_REEXEC:-0}" != "1" ]] && [[ -x "$project_codex_pony" ]] && [[ "$current_script" != "$project_codex_pony" ]]; then
  export AGENIC_PONY_REFRESH_REEXEC=1
  pony_launch_debug "codex-pony reexec project wrapper: project_codex_pony=$project_codex_pony"
  exec "$project_codex_pony" "$@"
fi

if [[ -n "${WARP_LAUNCH_CONFIG_DIR:-}" || -d /mnt/c/Users/"$USER"/AppData/Roaming/warp/Warp/data/launch_configurations ]]; then
  "$agenic_root/scripts/install-warp-launch-configs.sh" "$project_root" >/dev/null || true
fi

source_launch_env() {
  local env_file=""

  if [[ -n "${AGENIC_PONY_ENV_FILE:-}" ]]; then
    env_file="${AGENIC_PONY_ENV_FILE}"
  elif [[ -f "$AGENIC_PROJECT_PONY_RUNTIME_DIR/launch.env" ]]; then
    env_file="$AGENIC_PROJECT_PONY_RUNTIME_DIR/launch.env"
  else
    env_file="$(default_launch_env_file "$AGENIC_PROJECT_ROOT")"
  fi

  [[ -n "$env_file" ]] || return 0
  if [[ ! -f "$env_file" ]]; then
    pony_launch_debug "codex-pony launch env missing: env_file=$env_file"
    return 0
  fi

  set -a
  source "$env_file"
  set +a
  pony_launch_debug "codex-pony launch env loaded: env_file=$env_file github_token=$( [[ -n "${GITHUB_PAT_TOKEN:-}" ]] && printf 'present' || printf 'missing' )"
}

source_launch_env

repair_or_reject_project_codex_dir() {
  local codex_path="${AGENIC_PROJECT_ROOT}/.codex"
  if [[ -d "$codex_path" ]]; then
    if [[ ! -e "$codex_path/config.toml" ]]; then
      : >"$codex_path/config.toml"
    fi
    return 0
  fi

  if [[ -e "$codex_path" ]]; then
    if [[ ! -s "$codex_path" ]]; then
      rm -f "$codex_path"
      mkdir -p "$codex_path"
      : >"$codex_path/config.toml"
      pony_launch_debug "codex-pony repaired stray empty .codex file: path=$codex_path"
      return 0
    fi

    pony_launch_debug "codex-pony error: project .codex path is not a directory: path=$codex_path"
    printf '%s\n' "ERROR: ${codex_path} exists as a file, not a directory. Move or remove it, then create ${codex_path}/config.toml." >&2
    exit 1
  fi
}

repair_or_reject_project_codex_dir

write_agent_session_config() {
  local personality="${1:-}"
  [[ -n "$personality" ]] || return 0
  local config_script
  config_script="$(agent_config_script_path)"
  local session_config="${CODEX_AGENT_CONFIG:-${AGENIC_AGENT_CONFIG_PATH:-$(agent_session_config_path "$personality")}}"
  local registry_path="${AGENIC_PONY_REGISTRY_LOG_PATH:-$(agent_registry_log_path)}"
  local message_log_path="${AGENIC_PONY_CHAT_LOG_PATH:-$(agent_message_log_path)}"
  [[ -f "$config_script" ]] || return 0
  python3 "$config_script" write-session \
    --agent "$personality" \
    --project-root "$AGENIC_PROJECT_ROOT" \
    --output "$session_config" \
    --registry-path "$registry_path" \
    --message-log-path "$message_log_path"
  export CODEX_AGENT_CONFIG="$session_config"
  export AGENIC_AGENT_CONFIG_PATH="$session_config"
}

write_agent_session_config "${PERSONALITY:-${AGENIC_LAUNCH_PERSONALITY:-}}"

workspace_writable_root_args() {
  local personality="${1:-}"
  local session_config="${CODEX_AGENT_CONFIG:-${AGENIC_AGENT_CONFIG_PATH:-}}"
  python3 - "$personality" "${AGENIC_PROJECT_ROOT:-}" "$session_config" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

personality = sys.argv[1].strip()
project_root_arg = sys.argv[2].strip()
session_config_arg = sys.argv[3].strip()
roots: list[str] = []


def add_dir(path: str | Path | None) -> None:
    if not path:
        return
    resolved = Path(path).expanduser().resolve()
    if not resolved.exists() or not resolved.is_dir():
        return
    value = str(resolved)
    if value not in roots:
        roots.append(value)


def add_runtime_path(path: str | Path | None) -> None:
    if not path:
        return
    candidate = Path(path).expanduser()
    resolved = candidate.resolve()
    if resolved.exists() and resolved.is_dir():
        add_dir(resolved)
        return
    add_dir(resolved.parent)


def add_git_metadata(root: Path) -> None:
    for flag in ("--absolute-git-dir", "--git-common-dir"):
        result = subprocess.run(
            ["git", "-C", str(root), "rev-parse", flag],
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode == 0:
            candidate = result.stdout.strip()
            if candidate:
                add_dir(candidate)


def add_project_scope(root: Path) -> None:
    add_dir(root)
    add_dir(root / "pony" / "runtime")
    add_dir(root / "pony" / "team.coordination")
    add_dir(root / "pony" / "work")
    add_git_metadata(root)


if project_root_arg:
    add_project_scope(Path(project_root_arg))

if session_config_arg:
    config_path = Path(session_config_arg).expanduser()
    if config_path.exists():
        try:
            payload = json.loads(config_path.read_text(encoding="utf-8"))
        except Exception:
            payload = {}
        for key in ("registryPath", "messageLogPath"):
            value = payload.get(key)
            if value:
                add_runtime_path(value)
        if personality == "PRINCESS_CELESTIA_SOL_INVICTUS":
            for agent in payload.get("agents", []):
                project_root = agent.get("projectRoot")
                if project_root:
                    add_project_scope(Path(project_root))
                for key in ("registryPath", "messageLogPath"):
                    value = agent.get(key)
                    if value:
                        add_runtime_path(value)
        elif personality == "TWILIGHT_SPARKLE":
            for agent in payload.get("agents", []):
                if not agent.get("globalSingleton"):
                    continue
                if agent.get("agentId") != "PRINCESS_CELESTIA_SOL_INVICTUS":
                    continue
                value = agent.get("messageLogPath")
                if value:
                    add_runtime_path(value)
                break

print("-c")
print(f"sandbox_workspace_write.writable_roots={json.dumps(roots)}")
PY
}

preferred_repo_codex="/home/ggb66/dev/codex/codex-rs/target/debug/codex-tui"
effective_codex_profile="${CODEX_PONY_PROFILE:-}"
profile_config_path=""
if [[ -n "$effective_codex_profile" ]]; then
  profile_config_path="${CODEX_HOME:-$HOME/.codex}/${effective_codex_profile}.config.toml"
fi
codex_bin="${CODEX_PONY_BIN:-}"
if [[ -z "$codex_bin" ]]; then
  if [[ -x "$preferred_repo_codex" ]]; then
    codex_bin="$preferred_repo_codex"
  elif command -v codex >/dev/null 2>&1; then
    codex_bin="codex"
  elif [[ -x /tmp/codex-pony-target/debug/codex-tui ]]; then
    codex_bin="/tmp/codex-pony-target/debug/codex-tui"
  fi
fi

if [[ -z "$codex_bin" ]]; then
  pony_launch_debug "codex-pony error: no codex binary available"
  echo "ERROR: codex is not available on PATH" >&2
  exit 1
fi

if [[ -x "$AGENIC_PROJECT_PONY_SCRIPTS_DIR/queue-runtime.sh" ]]; then
  "$AGENIC_PROJECT_PONY_SCRIPTS_DIR/queue-runtime.sh" init >/dev/null
fi

append_codex_profile_args() {
  local profile="$1"
  local line key value

  if [[ "$(basename "$codex_bin")" != "codex-tui" || ! -f "$profile_config_path" ]]; then
    codex_args+=(-p "$profile")
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    [[ "$line" != \[* ]] || continue
    [[ "$line" == *=* ]] || continue

    key="${line%%=*}"
    value="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    value="${value#"${value%%[![:space:]]*}"}"
    codex_args+=(-c "$key=$value")
  done <"$profile_config_path"
}

codex_args=()
if glyph="$(codex_prompt_glyph_for_personality "${PERSONALITY:-}" 2>/dev/null)"; then
  codex_args+=(-c "tui.prompt_glyph=\"$glyph\"")
fi
if background="$(codex_prompt_background_for_personality "${PERSONALITY:-}" 2>/dev/null)"; then
  codex_args+=(-c "tui.prompt_background=\"$background\"")
fi
if [[ -n "${PERSONALITY:-}" ]]; then
  codex_args+=(-c "tui.terminal_title=[]")
fi
while IFS= read -r arg; do
  codex_args+=("$arg")
done < <(workspace_writable_root_args "${PERSONALITY:-${AGENIC_LAUNCH_PERSONALITY:-}}")
if [[ -n "$effective_codex_profile" ]]; then
  append_codex_profile_args "$effective_codex_profile"
fi
if [[ -n "${CODEX_PONY_PID_FILE:-}" ]]; then
  printf '%s\n' "$$" >"$CODEX_PONY_PID_FILE"
fi

profile_arg="none"
if [[ -n "$effective_codex_profile" ]]; then
  profile_arg="$effective_codex_profile"
elif [[ "${1:-}" == "-p" ]] && [[ -n "${2:-}" ]]; then
  profile_arg="$2"
fi
pony_launch_debug "codex-pony exec: codex_bin=$codex_bin profile=$profile_arg project_root=$project_root stdin_tty=$( [[ -t 0 ]] && printf yes || printf no ) project_root=$project_root"
run_codex_and_log_exit() {
  "$@"
  local exit_code=$?
  pony_launch_debug "codex-pony child exited: exit_code=$exit_code"
  return "$exit_code"
}
if [[ ! -t 0 || ! -t 1 ]]; then
  if ( : </dev/tty ) 2>/dev/null; then
    pony_launch_debug "codex-pony rebind stdio to /dev/tty before exec: stdin_tty=$( [[ -t 0 ]] && printf yes || printf no ) stdout_tty=$( [[ -t 1 ]] && printf yes || printf no )"
    run_codex_and_log_exit "$codex_bin" "${codex_args[@]}" "$@" </dev/tty >/dev/tty 2> >(tee -a "${AGENIC_PONY_LAUNCH_DEBUG_LOG}" >&2)
    exit $?
  fi
fi
run_codex_and_log_exit "$codex_bin" "${codex_args[@]}" "$@" 2> >(tee -a "${AGENIC_PONY_LAUNCH_DEBUG_LOG}" >&2)
exit $?
